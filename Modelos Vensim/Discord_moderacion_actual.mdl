{UTF-8}
Usuarios activos= INTEG (
	Usuarios que llegan - Usuarios que se van,
		100000)
	~	usuarios
	~	Personas activas en la comunidad representativa de Discord (SUPUESTO: \
		100.000).
	|

Usuarios que llegan=
	Usuarios activos * Tasa de crecimiento base * Reputacion externa
	~	usuarios/Week
	~	Los usuarios atraen a más usuarios (ciclo R1), según la reputación que \
		la comunidad tiene afuera.
	|

Usuarios que se van=
	Usuarios activos * Tasa de abandono por desconfianza * (1 - Confianza de la comunidad\
		)
	~	usuarios/Week
	~	Cuanto menor es la confianza, más usuarios abandonan.
	|

Tasa de crecimiento base=
	0.015
	~	1/Week
	~	SUPUESTO. Con reputación 0,8 da 1,2 % semanal.
	|

Tasa de abandono por desconfianza=
	0.05
	~	1/Week
	~	SUPUESTO. Con confianza 0,8 da 1 % semanal.
	|

Reputacion externa=
	DELAY FIXED(Confianza de la comunidad, Retraso de la reputacion, 0.8)
	~	Dmnl
	~	RETRASO DE INFORMACIÓN PURO (DELAY FIXED): la confianza interna tarda \
		semanas en conocerse afuera.
	|

Retraso de la reputacion=
	6
	~	Week
	~	SUPUESTO.
	|

Confianza de la comunidad= INTEG (
	Cambio de confianza,
		0.8)
	~	Dmnl
	~	Índice de 0 a 1 (SUPUESTO: los informes no miden confianza). Nivel de \
		información.
	|

Cambio de confianza=
	(Confianza deseada - Confianza de la comunidad) / Tiempo para ajustar la confianza
	~	1/Week
	~	La confianza se acerca poco a poco a la confianza deseada (retraso de \
		percepción de primer orden).
	|

Tiempo para ajustar la confianza=
	8
	~	Week
	~	SUPUESTO.
	|

Confianza deseada=
	MAX(0, 1 - Molestia por contenido nocivo - Molestia por bloqueos injustos)
	~	Dmnl
	~	Confianza que tendría la comunidad con el nivel actual de molestias.
	|

Molestia por contenido nocivo=
	(Nocivo que se escapa / Usuarios activos) * ZIDZ(Denuncias pendientes, Denuncias resueltas\
		) / Tolerancia al contenido nocivo
	~	Dmnl
	~	Contenido nocivo que cada usuario ve, multiplicado por el tiempo que sigue \
		visible mientras la denuncia espera.
	|

Tolerancia al contenido nocivo=
	0.001836
	~	piezas/usuarios
	~	CALIBRADO: con los valores iniciales la molestia vale 0,1.
	|

Molestia por bloqueos injustos=
	MAX(0, Bloqueos por error - Apelaciones aceptadas) / Usuarios activos / Tolerancia a bloqueos injustos
	~	Dmnl
	~	Bloqueos a contenido legítimo que nadie corrige, por usuario.
	|

Tolerancia a bloqueos injustos=
	0.1573
	~	piezas/(usuarios*Week)
	~	CALIBRADO: con los valores iniciales la molestia vale 0,1.
	|

Contenido nocivo por usuario=
	0.02
	~	piezas/(usuarios*Week)
	~	SUPUESTO: 1 de cada 1.000 mensajes (20 mensajes por usuario a la semana) \
		es nocivo (no-spam).
	|

Mensajes sanos por usuario=
	19.98
	~	piezas/(usuarios*Week)
	~	SUPUESTO: el resto de los 20 mensajes semanales.
	|

Contenido nocivo=
	Usuarios activos * Contenido nocivo por usuario
	~	piezas/Week
	~	Acoso, odio, etc. (sin spam).
	|

Sensibilidad del filtro IA=0.973
	~	Dmnl [0.5,0.999,0.001]
	~	PALANCA DE POLÍTICA. DATO: el sistema automático detecta 97,3 % del \
		contenido infractor (DSA 2025, p. 9).
	|

Nocivo bloqueado=
	Contenido nocivo * Sensibilidad del filtro IA
	~	piezas/Week
	~	Aciertos del filtro (verdaderos positivos).
	|

Nocivo que se escapa=
	Contenido nocivo * (1 - Sensibilidad del filtro IA)
	~	piezas/Week
	~	Contenido nocivo que el filtro no detecta (falsos negativos).
	|

Factor de error del filtro=
	2.2033e-05
	~	Dmnl
	~	CALIBRADO para que la precisión inicial sea 55,1 % (DSA 2025, p. 9).
	|

Bloqueos por error=
	Usuarios activos * Mensajes sanos por usuario * Factor de error del filtro * Sensibilidad del filtro IA\
		 / (1 - Sensibilidad del filtro IA)
	~	piezas/Week
	~	Contenido legítimo bloqueado (falsos positivos). NO LINEAL: crece muy \
		rápido cuando la sensibilidad se acerca a 1.
	|

Precision del filtro=
	ZIDZ(Nocivo bloqueado, Nocivo bloqueado + Bloqueos por error)
	~	Dmnl
	~	De todo lo bloqueado, qué fracción era realmente nociva. Meta: 0,551 \
		(DSA 2025).
	|

Apelaciones pendientes= INTEG (
	Apelaciones que llegan - Apelaciones resueltas,
		186)
	~	piezas
	~	Cola EN PARALELO con las denuncias: ambas usan la misma capacidad de \
		revisión.
	|

Apelaciones que llegan=
	DELAY3((Nocivo bloqueado + Bloqueos por error) * Fraccion de bloqueados que apela, Tiempo de reaccion de los usuarios\
		)
	~	piezas/Week
	~	RETRASO MATERIAL DE TERCER ORDEN (DELAY3): los usuarios bloqueados tardan \
		en apelar.
	|

Fraccion de bloqueados que apela=
	0.155
	~	Dmnl
	~	DATO: mediana de la tasa de apelación 2022-2023 (informes generales).
	|

Tiempo de reaccion de los usuarios=
	1
	~	Week
	~	SUPUESTO: tiempo para apelar o denunciar.
	|

Apelaciones resueltas=
	MIN(Apelaciones pendientes / Tiempo minimo de revision, Capacidad de revision * XIDZ\
		(Apelaciones pendientes, Apelaciones pendientes + Denuncias pendientes, 0.5))
	~	piezas/Week
	~	La capacidad se reparte entre las dos colas según su tamaño (recurso \
		común).
	|

Tiempo minimo de revision=
	0.34
	~	Week
	~	DATO: 57,34 h, mediana de resolución de quejas (DSA 2024).
	|

Apelaciones aceptadas=
	Apelaciones resueltas * (1 - Precision del filtro) * Probabilidad de corregir un error
	~	piezas/Week
	~	Bloqueos por error que se revierten al apelar.
	|

Probabilidad de corregir un error=
	0.0532
	~	Dmnl
	~	CALIBRADO: reversión inicial 2,39 % (mediana de cuentas restauradas / \
		apelaciones, Q1 2022 - H1 2024).
	|

Denuncias pendientes= INTEG (
	Denuncias que llegan - Denuncias resueltas,
		9)
	~	piezas
	~	Cola EN PARALELO: contenido nocivo denunciado por usuarios.
	|

Denuncias que llegan=
	DELAY1(Nocivo que se escapa * Fraccion de nocivo denunciado, Tiempo de reaccion de los usuarios\
		)
	~	piezas/Week
	~	RETRASO MATERIAL DE PRIMER ORDEN (DELAY1).
	|

Fraccion de nocivo denunciado=
	0.5
	~	Dmnl
	~	SUPUESTO.
	|

Denuncias resueltas=
	MIN(Denuncias pendientes / Tiempo minimo de revision, Capacidad de revision * XIDZ(Denuncias pendientes\
		, Apelaciones pendientes + Denuncias pendientes, 0.5))
	~	piezas/Week
	~		|

Capacidad de revision=
	Moderadores activos * Productividad por moderador
	~	piezas/Week
	~	Recurso común que comparten apelaciones y denuncias (tragedia de los \
		comunes).
	|

Productividad por moderador=
	120
	~	piezas/(moderadores*Week)
	~	SUPUESTO: carga inicial cercana a 0,8.
	|

Carga percibida=
	SMOOTH(XIDZ(Apelaciones que llegan + Denuncias que llegan, Capacidad de revision, 10\
		), Tiempo para percibir la carga)
	~	Dmnl
	~	RETRASO DE INFORMACIÓN (SMOOTH): trabajo que llega ÷ capacidad, como lo \
		perciben los moderadores con retraso.
	|

Tiempo para percibir la carga=
	4
	~	Week
	~	SUPUESTO.
	|

Moderadores en entrenamiento= INTEG (
	Voluntarios nuevos - Moderadores graduados,
		0.48)
	~	moderadores
	~	NIVEL EN SERIE con Moderadores activos.
	|

Voluntarios nuevos=
	Usuarios activos * Tasa de voluntariado * Confianza de la comunidad
	~	moderadores/Week
	~	Una comunidad que confía aporta voluntarios.
	|

Tasa de voluntariado=
	1.5e-06
	~	moderadores/(usuarios*Week)
	~	CALIBRADO: voluntarios iniciales = renuncias iniciales.
	|

Moderadores graduados=
	Moderadores en entrenamiento / Tiempo de entrenamiento
	~	moderadores/Week
	~		|

Tiempo de entrenamiento=
	4
	~	Week
	~	SUPUESTO.
	|

Moderadores activos= INTEG (
	Moderadores graduados - Moderadores que renuncian,
		6)
	~	moderadores
	~	SUPUESTO: 6 moderadores (el DSA no publica personal).
	|

Moderadores que renuncian=
	Moderadores activos * Tasa normal de renuncia * MIN(4, MAX(1, Carga percibida) ^ 2)
	~	moderadores/Week
	~	NO LINEAL: por encima de carga 1 el agotamiento multiplica las renuncias \
		(ciclo R2), como máximo por 4 (SUPUESTO).
	|

Tasa normal de renuncia=
	0.02
	~	1/Week
	~	SUPUESTO: un moderador dura en promedio 50 semanas.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 104
	~	Week
	~	Horizonte de 104 semanas (mínimo exigido: 70).
	|

INITIAL TIME  = 0
	~	Week
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Week [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Week [0,?]
	~	Menor que la constante de tiempo más corta (0,34 semanas).
	|

